<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProspectLynk | Executive Access</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Chosen Palette: Ultra-Modern Corporate (Slate #020617, Brand Orange #E97132, Pure White) -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        
        :root {
            --brand-orange: #E97132;
            --brand-navy: #020617;
        }

        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #f8fafc;
            color: #1e293b;
            overflow-x: hidden;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        .login-gradient {
            background: radial-gradient(circle at center, #1e1b4b 0%, #020617 100%);
        }

        .input-focus:focus {
            border-color: var(--brand-orange);
            box-shadow: 0 0 0 4px rgba(233, 113, 50, 0.1);
        }

        .chart-container { 
            position: relative; 
            width: 100%; 
            height: 300px; 
            margin: 0 auto; 
        }

        .loader {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .fade-in { animation: fadeIn 0.5s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
</head>
<body class="antialiased">

    <!-- LOGIN SECTION -->
    <div id="login-overlay" class="fixed inset-0 z-[100] flex items-center justify-center login-gradient px-4">
        <div class="max-w-md w-full z-10 fade-in">
            <div class="text-center mb-8">
                <div class="inline-flex items-center gap-2 mb-4">
                    <div class="w-9 h-9 bg-indigo-600 rounded-lg flex items-center justify-center shadow-lg">
                        <i class="fas fa-link text-white text-lg"></i>
                    </div>
                    <span class="text-xl font-extrabold text-white tracking-tighter">Prospect<span class="text-indigo-400">Lynk</span></span>
                </div>
                <h1 class="text-3xl font-extrabold text-white tracking-tight">Portal Access</h1>
            </div>

            <div class="glass-panel p-8 rounded-[2rem] shadow-2xl">
                <div id="login-form" class="space-y-5">
                    <div>
                        <input type="text" id="username" placeholder="Email" class="w-full bg-white/50 border border-slate-200 rounded-xl px-5 py-3.5 text-slate-900 input-focus transition outline-none font-medium">
                    </div>
                    <div>
                        <input type="password" id="password" placeholder="Password" class="w-full bg-white/50 border border-slate-200 rounded-xl px-5 py-3.5 text-slate-900 input-focus transition outline-none font-medium">
                    </div>
                    <button onclick="handleLogin()" class="w-full bg-[#E97132] hover:bg-[#d15d22] text-white font-bold py-4 rounded-xl shadow-lg transition-all flex items-center justify-center gap-2">
                        <span id="btn-text">Log In</span>
                        <div id="btn-loader" class="loader hidden"></div>
                    </button>
                </div>
                <p id="login-error" class="text-red-500 text-xs mt-4 font-bold text-center hidden">Invalid Access Credentials</p>
            </div>
            <p class="text-center text-white/20 text-[9px] mt-6 uppercase tracking-widest font-bold">Secure Partner Environment © 2026</p>
        </div>
    </div>

    <!-- PORTAL CONTENT -->
    <div id="portal-content" class="hidden opacity-0 transition-opacity duration-500">
        
        <nav class="bg-white/90 backdrop-blur-lg border-b border-slate-100 sticky top-0 z-50 h-16 flex items-center">
            <div class="max-w-7xl mx-auto px-6 w-full flex items-center justify-between">
                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-1.5">
                        <div class="w-6 h-6 bg-slate-900 rounded flex items-center justify-center text-[10px] text-white"><i class="fas fa-link"></i></div>
                        <span class="font-bold text-lg text-slate-900 tracking-tighter">Prospect<span class="text-indigo-600">Lynk</span></span>
                    </div>
                    <div class="h-4 w-px bg-slate-200"></div>
                    <span class="text-xs font-bold text-slate-500 uppercase tracking-tighter">Next Communications</span>
                </div>
                <button onclick="location.reload()" class="text-slate-400 hover:text-red-500 transition-colors">
                    <i class="fas fa-power-off text-sm"></i>
                </button>
            </div>
        </nav>

        <main class="max-w-7xl mx-auto px-6 py-8">
            
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
                <div>
                    <h2 class="text-3xl font-extrabold text-slate-900">Campaign Snapshot</h2>
                    <p class="text-sm text-slate-500 mt-1 font-medium italic"></p>
                </div>
                <div class="mt-4 md:mt-0 flex items-center gap-3 bg-indigo-900 text-white px-4 py-2 rounded-xl text-xs font-bold">
                    <i class="fas fa-code-branch"></i>
                    <span>Template: Step 1A</span>
                </div>
            </div>

            <!-- KPIs -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-2">Total Contacts</p>
                    <h3 class="text-2xl font-extrabold text-slate-900">147</h3>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-2">Open Rate</p>
                    <h3 class="text-2xl font-extrabold text-slate-400">N/A*</h3>
                    <p class="text-[9px] text-indigo-500 mt-1 font-bold">*Apollo Free Limit</p>
                </div>
                <div class="bg-white p-5 rounded-2xl border-2 border-orange-100 shadow-sm">
                    <p class="text-[9px] font-bold text-orange-600 uppercase tracking-widest mb-2">Reply Rate</p>
                    <div class="flex items-center gap-1.5">
                        <h3 class="text-2xl font-extrabold text-slate-900">1.75%</h3>
                        <div class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></div>
                    </div>
                    <p class="text-[9px] text-slate-400 mt-1">Benchmark: 1 - 3%</p>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm">
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mb-2">Deflection</p>
                    <h3 class="text-2xl font-extrabold text-slate-900">3.4%</h3>
                    <p class="text-[9px] text-red-500 mt-1 font-bold italic">Firewall Resist</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-6">
                    
                    <!-- Blueprint -->
                    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                        <div class="grid sm:grid-cols-2 gap-4">
                            <div class="bg-slate-50 p-4 rounded-xl">
                                <p class="text-[9px] font-extrabold text-slate-400 uppercase tracking-widest mb-1">Audience</p>
                                <p class="text-xs font-bold">Global Travel Operators (Thomas Cook/Xenium)</p>
                            </div>
                            <div class="bg-orange-50 p-4 rounded-xl border border-orange-100">
                                <p class="text-[9px] font-extrabold text-orange-600 uppercase tracking-widest mb-1">Incentive</p>
                                <p class="text-xs font-bold">€1,000 Free Roadmap Pilot Credit</p>
                            </div>
                        </div>
                    </div>

                    <!-- Chart -->
                    <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm">
                        <h4 class="text-lg font-extrabold text-slate-900 mb-6">Engagement Flow</h4>
                        <div class="chart-container">
                            <canvas id="mainChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="space-y-6">
                    <div class="bg-slate-900 text-white p-6 rounded-3xl shadow-xl">
                        <h4 class="text-orange-400 font-bold uppercase text-[9px] tracking-widest mb-3">System Note</h4>
                        <h3 class="text-lg font-bold mb-3">Apollo Free Sync</h3>
                        <p class="text-slate-400 text-xs leading-relaxed mb-4">
                            Open tracking is currently disabled due to Apollo Free Tier constraints. This does not impact delivery or reply logging.
                        </p>
                        <div class="text-[10px] bg-white/5 p-3 rounded-lg border border-white/10 font-bold text-indigo-300">
                            Success: 100% conversion of identified interest.
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                        <h4 class="font-bold text-slate-900 text-xs uppercase mb-4 tracking-widest">Phase Progression</h4>
                        <div class="space-y-4">
                            <div class="flex items-center gap-3">
                                <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                                <p class="text-xs font-bold text-slate-700">Baseline Outreach</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></div>
                                <p class="text-xs font-bold text-slate-900">A/B Optimization</p>
                            </div>
                            <div class="flex items-center gap-3 opacity-30">
                                <div class="w-2 h-2 bg-slate-300 rounded-full"></div>
                                <p class="text-xs font-bold text-slate-400">Scale Acquisition</p>
                            </div>
                        </div>
                    </div>

                    <div class="text-center p-4">
                        <div class="flex items-center justify-center gap-1.5 opacity-40">
                            <div class="w-5 h-5 bg-slate-900 rounded flex items-center justify-center text-[8px] text-white"><i class="fas fa-link"></i></div>
                            <span class="font-bold text-slate-900 text-[10px] tracking-tighter">ProspectLynk Intelligence</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function handleLogin() {
            const u = document.getElementById('username').value.trim();
            const p = document.getElementById('password').value.trim();
            const btnText = document.getElementById('btn-text');
            const btnLoader = document.getElementById('btn-loader');

            if (u === 'jigs@nextonesim.com' && p === 'NextOneSIM') {
                btnText.textContent = 'Accessing...';
                btnLoader.classList.remove('hidden');
                setTimeout(() => {
                    document.getElementById('login-overlay').classList.add('hidden');
                    const portal = document.getElementById('portal-content');
                    portal.classList.remove('hidden');
                    setTimeout(() => portal.classList.add('opacity-100'), 50);
                    initCharts();
                }, 800);
            } else {
                document.getElementById('login-error').classList.remove('hidden');
            }
        }

        function initCharts() {
            const ctx = document.getElementById('mainChart').getContext('2d');
            Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
            
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Identified', 'Delivered', 'Deflected', 'Hot Leads'],
                    datasets: [{
                        data: [147, 105, 5, 2], 
                        backgroundColor: ['#020617', '#4338CA', '#F1F5F9', '#E97132'],
                        borderRadius: 8,
                        barThickness: 35
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { display: false } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
    </script>
</body>
</html>
